{
  "name": "oh-my-oms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/cdk"
  ],
  "scripts": {
    "test:u2:unit": "vitest run --config tests/u2/vitest.unit.config.ts",
    "test:u2:integration": "OMS_U2_DATABASE_PROFILE=verification-isolated vitest run --config tests/u2/vitest.integration.config.ts",
    "test:u2:coverage": "OMS_U2_DATABASE_PROFILE=verification-isolated vitest run --config tests/u2/vitest.coverage.config.ts --coverage",
    "test:u2:e2e": "OMS_U2_DATABASE_PROFILE=e2e-isolated playwright test --config tests/u2/playwright.config.ts",
    "test:u2:runtime-security": "OMS_U2_DATABASE_PROFILE=verification-isolated vitest run --config tests/u2/vitest.integration.config.ts tests/u2/integration/runtime-security.spec.ts",
    "test:u2:performance": "node --import tsx scripts/u2/performance.ts",
    "test:u2:recovery": "node --import tsx scripts/u2/recovery.ts",
    "check:u2": "node --import tsx scripts/u2/check.ts",
    "security:u2": "node --import tsx scripts/u2/security.ts",
    "synth:u2": "node --import tsx scripts/u2/synth.ts",
    "verify:u2:release": "node --import tsx scripts/u2/release-validation.ts",
    "bootstrap:u2:ci": "node --import tsx scripts/u2/bootstrap-ci.ts",
    "pretest:u2:integration": "node --import tsx scripts/u2/prepare-test-databases.ts",
    "pretest:u2:coverage": "node --import tsx scripts/u2/prepare-test-databases.ts",
    "pretest:u2:e2e": "node --import tsx scripts/u2/prepare-test-databases.ts",
    "pretest:u2:runtime-security": "node --import tsx scripts/u2/prepare-test-databases.ts",
    "test:u1:unit": "vitest run --config tests/u1/vitest.unit.config.ts",
    "test:u1:integration": "OMS_U1_DATABASE_PROFILE=verification-isolated vitest run --config tests/u1/vitest.integration.config.ts",
    "test:u1:coverage": "OMS_U1_DATABASE_PROFILE=verification-isolated vitest run --config tests/u1/vitest.coverage.config.ts --coverage",
    "test:u1:e2e": "OMS_U1_DATABASE_PROFILE=e2e-isolated playwright test --config tests/u1/playwright.config.ts",
    "check:u1": "node --import tsx scripts/u1/check.ts",
    "security:u1": "node --import tsx scripts/u1/security.ts",
    "test:u1:performance": "node --import tsx scripts/u1/performance.ts",
    "test:u1:recovery": "OMS_U1_DATABASE_PROFILE=verification-isolated vitest run --config tests/u1/vitest.integration.config.ts tests/u1/integration/recovery.spec.ts",
    "verify:u1:skeleton": "node --import tsx scripts/u1/verify-skeleton.ts",
    "start:u1:api": "node --import tsx apps/api/src/main.ts",
    "start:u1:worker": "node --import tsx apps/worker/src/main.ts",
    "dev:u1:customer": "next dev apps/customer-web --hostname 127.0.0.1 --port 3100",
    "dev:u1:staff": "next dev apps/staff-web --hostname 127.0.0.1 --port 3200",
    "format:u1": "prettier --write apps packages infra/cdk tests/u1 scripts/u1 docs/u1 package.json tsconfig.json eslint.config.mjs",
    "postinstall": "node --import tsx scripts/u1/cdk-bundle.ts --install",
    "verify:u1:cdk-bundle": "node --import tsx scripts/u1/cdk-bundle.ts",
    "synth:u1": "node --import tsx scripts/u1/synth.ts",
    "pretest:u1:integration": "node --import tsx scripts/u1/prepare-test-databases.ts",
    "pretest:u1:coverage": "node --import tsx scripts/u1/prepare-test-databases.ts",
    "pretest:u1:recovery": "node --import tsx scripts/u1/prepare-test-databases.ts",
    "pretest:u1:e2e": "node --import tsx scripts/u1/prepare-test-databases.ts",
    "bootstrap:u1:tools": "node --import tsx scripts/u1/bootstrap-tools.ts",
    "bootstrap:u1:ci": "node --import tsx scripts/u1/ci-bootstrap.ts",
    "test:u1:profile": "vitest run --config tests/u1/vitest.profile.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1147.0",
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-sns": "3.1147.0",
    "@aws-sdk/client-sqs": "3.1147.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.272.0",
    "brace-expansion": "5.0.12",
    "constructs": "10.8.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
