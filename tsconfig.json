{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "infra/cdk/**/*.ts",
    "tests/u1/**/*.ts",
    "tests/u1/**/*.tsx",
    "scripts/u1/**/*.ts",
    "tests/u2/**/*.ts",
    "tests/u2/**/*.tsx",
    "tests/project/**/*.ts",
    "scripts/u2/**/*.ts"
  ],
  "exclude": ["node_modules", "**/.next/**"]
}
